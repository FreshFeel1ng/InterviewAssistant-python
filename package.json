{
  "name": "interview-assistant-python",
  "version": "1.0.0",
  "description": "AI Interview Assistant - Python Backend + React Frontend",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "python -m uvicorn server.main:app --host 0.0.0.0 --port 3001 --reload",
    "dev:client": "vite",
    "build": "vite build"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "@vitejs/plugin-react": "^4.3.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "tailwindcss": "^3.4.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "concurrently": "^9.0.0"
  }
}
